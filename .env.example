# Copy to .env, then add credentials only to the local ignored file.
# Never commit .env or paste live credentials into source code.
OPENARVA_PROVIDER=openai
OPENARVA_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Set OPENARVA_LOCAL_ONLY=true to reject cloud providers and cloud image routing.
OPENARVA_LOCAL_ONLY=false
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1

# Discord requires the Message Content Intent in the Discord developer portal.
# Both token and a comma-separated channel allowlist are required.
# To opt in, also set OPENARVA_CONNECTORS=discord.
OPENARVA_CONNECTORS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# Optional existing integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
